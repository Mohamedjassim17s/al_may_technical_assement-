# Environment Configuration Template
# Copy this file to .env.local for local development

# Application Mode
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Apex Enterprise Management Portal"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mock REST API Latency Simulation (ms)
NEXT_PUBLIC_API_SIMULATE_DELAY=300

# Authentication & JWT Secrets (Simulated in Mock Provider)
NEXT_PUBLIC_AUTH_SECRET="super-secret-jwt-key-change-in-production"
